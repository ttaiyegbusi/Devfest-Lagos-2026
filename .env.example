# Copy to .env.local for development. Production values belong in the host's
# environment settings (Vercel: Project → Settings → Environment Variables),
# not in a file — SUBSCRIBE_TOKEN is a credential.


# The site's own origin, used to turn the share-card and Open Graph paths into
# absolute URLs. NEXT_PUBLIC_ means it is inlined into the client bundle at
# BUILD time, so changing it needs a rebuild, not just a restart.
#
# Without it these tags still render — they just point at localhost, which is
# right in development and wrong anywhere else: a link posted to Slack, X or
# WhatsApp shows no preview at all. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com


# Where the footer sign-up sends an address. app/api/subscribe/route.ts POSTs
#
#     {"email": "someone@example.com"}
#
# as application/json, and adds `Authorization: Bearer $SUBSCRIBE_TOKEN` when
# that is set.
#
# UNSET IS A DELIBERATE STATE, not an oversight: the route answers 503 and the
# footer says "Sign-up is not connected yet — nothing was saved." A form that
# thanks people and drops the address is worse, because nobody finds out until
# the list turns out to be empty.
#
# If the provider wants a different body — a Google Form wants form-encoded
# fields, Mailchimp wants status and merge_fields — that is the one thing in
# the route that has to change.
SUBSCRIBE_ENDPOINT=

# Only if the provider needs an Authorization header. Never commit a real one.
SUBSCRIBE_TOKEN=
